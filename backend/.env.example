# Configuración del Entorno
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,exp://*

# Supabase Platform
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase PostgreSQL Conexión Directa (para PostGIS)
# Ejemplo: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Recursos Cartográficos y Territoriales
GEOJSON_TERRITORY_PATH=data/formosa.json

# Geocodificación (Nominatim exige identificar la aplicación con un contacto)
# Ejemplo: NOMINATIM_USER_AGENT=nexo-map-api (contacto: correo@institucion.edu.ar)
NOMINATIM_USER_AGENT=nexo-map-api

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
REPORT_SUBMIT_RATE_LIMIT_PER_MINUTE=5
