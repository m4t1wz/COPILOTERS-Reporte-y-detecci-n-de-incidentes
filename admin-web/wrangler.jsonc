// Publicación del panel en Cloudflare Workers (sitio estático).
// "single-page-application": cualquier ruta (/reports/<id>, /map…) devuelve index.html.
{
  "name": "nexo-map-admin",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
